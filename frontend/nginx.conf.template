# The nginx image fills in ${CALC_SERVICE_URL} from the environment when the
# container starts. nginx's own variables, such as $uri, are left alone.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The calculate service. The browser calls /api on this server, so the
    # page and the API share one origin and no CORS setup is needed.
    location /api/ {
        proxy_pass ${CALC_SERVICE_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built files have a hash in their name, so they can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Everything else is the single-page application. The page itself is not
    # cached, so a new release is picked up on the next visit.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
